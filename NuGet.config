<?xml version="1.0" encoding="utf-8"?>
<!-- Offline build: the only package source is the folder offline-feed of this repository (relative to this file).
     <clear /> removes every source of the user and machine NuGet.config, so nothing can be loaded from the internet.
     The folder is filled by tools\Export-SelfXOfflineFeed.ps1 (online, once per SDK or package change) and checked
     against offline-feed\SelfX.OfflineFeed.json by tools\Build-SelfXBinaries.ps1 before every build. -->
<configuration>
  <packageSources>
    <clear />
    <add key="SelfXOffline" value="offline-feed" />
  </packageSources>
</configuration>
