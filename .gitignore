# Output of tools\New-SelfXIntuneWin.ps1 (.intunewin packages); the script creates the folder
/build/
# Prebuilt programs of SelfX Service (tools\Build-SelfXBinaries.ps1); they belong into the package, not into Git
/SelfX Service/Bin/

# dotnet build output of SelfX Service
SelfX Service/Service/Projects/**/obj/
SelfX Service/Service/Projects/**/bin/

# Offline build: the package cache of the build (tools\Build-SelfXBinaries.ps1 recreates it from offline-feed for every build)
/.nuget-cache/
