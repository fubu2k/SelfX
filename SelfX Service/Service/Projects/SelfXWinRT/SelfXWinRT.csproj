<Project Sdk="Microsoft.NET.Sdk">
  <!-- SelfX Service: WinRT access to the Windows Update orchestrator for PowerShell 7 (library, no logic).
       Windows SDK projection of .NET 10; the Windows version in the target framework is the SDK, not a minimum
       (the scripts catch a missing API on older Windows). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <AssemblyName>SelfXWinRT</AssemblyName>
    <RootNamespace>SelfX</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\SelfXWinRT.cs" Link="SelfXWinRT.cs" />
  </ItemGroup>
</Project>
