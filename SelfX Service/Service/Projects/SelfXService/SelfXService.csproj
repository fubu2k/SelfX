<Project Sdk="Microsoft.NET.Sdk">
  <!-- SelfX Service: the Windows service (runs as LocalSystem). .NET 10 (LTS), self-contained, one file.
       The assemblies in the file are not compressed: the runtime maps them from the file instead of unpacking them into private
       memory at every start (less private memory of the running service, faster start; the file is larger, the .intunewin hardly).
       The source is ..\..\SelfXService.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>SelfXService</AssemblyName>
    <RootNamespace>SelfX</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\SelfXService.cs" Link="SelfXService.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft package for ServiceBase (not part of the .NET runtime itself); fixed version. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
  </ItemGroup>
</Project>
