<Project Sdk="Microsoft.NET.Sdk">
  <!-- SelfX.exe: starts the SelfX window or the status icon without a console window. .NET 10, self-contained, one file.
       The source is the same file that Windows PowerShell 5.1 compiles (..\..\SelfXLauncher.cs). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SelfX</AssemblyName>
    <RootNamespace>SelfX</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\SelfXLauncher.cs" Link="SelfXLauncher.cs" />
  </ItemGroup>
</Project>
