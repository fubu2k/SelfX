<?xml version="1.0" encoding="utf-8"?>
<!--
  SelfX Service health configuration. Only administrators may change this file or HealthChecks scripts.
  Version 2.3.0 | 2026-10-28 | Wolfgang Baeck | Initial health checks.
  Version 2.3.3 | 2026-10-29 | Wolfgang Baeck | Pending reboot and updates-to-install checks (always active).
  Version 2.3.4 | 2026-10-29 | Wolfgang Baeck | Default Defender signature update remediation for Defender and Compliance.
  Version 2.5.0 | 2026-11-04 | Wolfgang Baeck | Background checks of the service (Background element).
  Version 2.5.4 | 2026-11-05 | Wolfgang Baeck | Defender and Compliance Fix button only while not OK (When="NotOK").
  Version 2.5.5 | 2026-11-05 | Wolfgang Baeck | Compliance row uses the local criteria check HealthChecks\Check-Compliance.ps1.
  Version 2.5.6 | 2026-11-05 | Wolfgang Baeck | Updates Fix button installs Windows updates and starts Store app updates (SYSTEM).
  Version 2.6.0 | 2026-11-06 | Wolfgang Baeck | Fix buttons for "Restart pending" (restart after confirmation) and the apps (retry
                                                failed installations); updates through the Windows Update orchestrator.
  Version 2.6.3 | 2026-11-06 | Wolfgang Baeck | Updates are installed through the Windows Update Agent again (UsoClient fails on 24H2).
  Version 3.1.0 | 2026-11-27 | fubu2k         | Fix button "Free up space" on the disk row of the system drive (part as the user, then as SYSTEM);
                                                thresholds of the SYSTEM part in DiskCleanup; Remediation attribute UserScript.
  Version 3.1.0 | 2026-11-27 | fubu2k         | Required Remediation attribute TerminalServer (Show or Hide) for Environment_Mode TerminalServer;
                                                all delivered repairs are Hide (they affect the whole device).
  Version 3.1.0 | 2026-11-28 | fubu2k         | Description of TerminalServer: the mode comes from Windows (Windows Server = TerminalServer).
  Version 3.1.0 | 2026-11-28 | fubu2k         | Applications StalledMinutes (download without progress); the app retry restarts the
                                                Intune Management Extension and is OtherSessions="Block"; retry of one app.
  -->
<HealthConfig>
  <!-- Background checks: the service runs all checks regularly and keeps the result for SelfX and the tray icon.
       IntervalMinutes   : 5-1440, default 15
       PauseOnBattery    : true = no background check while the device runs on battery (default)
       MaxCpuPercent     : 10-100, default 75. A check is postponed while the processor load is higher (100 = no limit)
       StartDelaySeconds : 0-3600, default 120. First check after the start of the service
       Enabled           : false = no background checks (SelfX then checks when it is opened) -->
  <Background Enabled="true" IntervalMinutes="15" PauseOnBattery="true" MaxCpuPercent="75" StartDelaySeconds="120" />
  <Disk UsedPercentError="90" MinimumFreeGB="20" />
  <!-- Free up space (Fix button of the disk row, SelfX_Device_FreeSpace.ps1 as SYSTEM):
       MinimumAgeDays  : 1-365, default 7. Only entries older than this are deleted in Windows\Temp and in the content
                         folders of the Intune Management Extension (Content\Incoming, Content\Staging, Windows\IMECache).
       ImeQuietMinutes : 1-1440, default 60. The Intune content is skipped while AgentExecutor.exe or msiexec.exe runs or
                         when something in these folders changed during the last ImeQuietMinutes (an installation may run).
       An invalid value stops the SYSTEM part before anything is deleted. -->
  <DiskCleanup MinimumAgeDays="7" ImeQuietMinutes="60" />
  <!-- Updates to install are read from the local Windows Update cache (no online scan). An empty
       cache whose last successful scan is older than MaxSearchAgeDays (1-365, default 14) is Unknown.
  <Updates MaxSearchAgeDays="14" />
  -->
  <!-- StalledMinutes: 30-1440, default 120. An app that is not installed yet and whose download file of the Intune Management
       Extension (Content\Incoming\<app id>_<revision>.bin) has not changed for this time is shown as "download stalled since ..."
       (an error of the row; the Fix button offers a retry of this app). Any other value makes the row Unknown. -->
  <Applications StalledMinutes="120">
    <!-- Wildcards match resolved application names, case-insensitively. IDs also work as exclusions. -->
    <!-- <Exclude Name="Example excluded application*" /> -->
    <!-- Optional names for Intune app IDs whose local cache contains no display name:
    <Application Id="00000000-0000-0000-0000-000000000000" Name="Example application" />
    -->
    <!-- Optional health probe for an app not covered by the IME cache:
    <Application Name="Business client" Script="Check-BusinessClient.ps1" TimeoutSeconds="15" />
    -->
  </Applications>
  <Services>
    <!-- Exact Windows service names, not display names. Expected: Running or Stopped.
    <Service Name="Spooler" Expected="Running" />
    -->
  </Services>
  <!-- Compliance check, installed under HealthChecks; no cloud credentials on clients. Intune evaluates
       compliance in the cloud and Windows stores no local compliance state, so Check-Compliance.ps1 checks
       the local criteria of the compliance policy (enrollment, BitLocker, Secure Boot, TPM, firewall,
       Defender, signatures; adjust $Require in the script to the policy). The Company Portal stays authoritative.
       Exit 0 = OK; any other exit code = Pending (shown as a warning, not as an error).
       Without this element the row shows Unknown. -->
  <Compliance Script="Check-Compliance.ps1" TimeoutSeconds="30" />
  <CustomChecks>
    <!-- Runs as SYSTEM. Read-only scripts only. Exit 0 = OK; exit 1 = Error.
    <Check Name="Example check" Script="Check-Example.ps1" TimeoutSeconds="30" />
    -->
  </CustomChecks>
  <Remediations>
    <!-- Explicit user-triggered repairs, never executed during health collection.
         Scripts are installed in Scripts_to_run. Id matches a health result type;
         optional Name restricts it to the exact service, drive or custom-check name.
         PendingReboot and Updates can be mapped as well. SelfX_Device_Restart.ps1 is recognised by
         SelfX: it asks the user with a restart warning (save your work) and never runs it in
         "Fix all problems".
         Optional When="NotOK" offers the button only while the status is not OK (default: Always).
         Optional OtherSessions="Block": a normal user cannot start the repair while another user has an active
         session (elevated administrators are not restricted).
         Required TerminalServer="Show" or "Hide": on a terminal server (Windows Server, mode TerminalServer) only Show is offered;
         Hide hides the button (also the UserScript part) and the service refuses the repair for every caller.
         Test-Catalog.ps1 requires the attribute.
    <Remediation Id="IME" Script="SelfX_Intune_RestartService.ps1" />
    <Remediation Id="Service" Name="Spooler" Script="Repair-Spooler.ps1" />
    -->
    <!-- Defender signature update (Update-MpSignature): offered on the Defender and Compliance rows
         only while they are not OK, because outdated signatures after a longer absence are a frequent
         cause of non-compliance. -->
    <Remediation Id="Defender" Script="SelfX_Defender_UpdateSignature.ps1" When="NotOK" TerminalServer="Hide" />
    <Remediation Id="Compliance" Script="SelfX_Defender_UpdateSignature.ps1" When="NotOK" TerminalServer="Hide" />
    <!-- Install the pending Windows updates now (policies of the device apply, never restarts) and start the
         Microsoft Store app updates as SYSTEM. Windows 11 24H2+: through the Windows Update orchestrator, as
         "Check for updates" in Settings; the Windows Update Agent installs only what is left. SelfX shows
         "Running..." until the installation has finished and then checks the whole status again.
         Optional TimeoutSeconds (max. 7200); the orchestrator is watched at most 90 minutes. -->
    <Remediation Id="Updates" Script="SelfX_Updates_Install.ps1" When="NotOK" TimeoutSeconds="7200" OtherSessions="Block" TerminalServer="Hide" />
    <!-- Restart Windows to complete a pending restart, only after the user confirmed the restart warning. -->
    <Remediation Id="PendingReboot" Script="SelfX_Device_Restart.ps1" When="NotOK" OtherSessions="Block" TerminalServer="Hide" />
    <!-- Retry failed Intune app installations now (instead of after the IME retry schedule of 24 hours):
         resets the cached error of the failed apps and restarts the Intune Management Extension. The window can also retry one
         app (failed or download stalled): the service then accepts only an app that its own reading of the IME cache lists.
         The restart of the Intune Management Extension also stops installations of other users: OtherSessions="Block". -->
    <Remediation Id="Applications" Script="SelfX_Apps_RetryInstall.ps1" When="NotOK" TimeoutSeconds="300" OtherSessions="Block" TerminalServer="Hide" />
    <!-- Free up space on the system drive while the disk row is not OK. SelfX asks once, lists what is deleted, then runs
         UserScript as the signed-in user (own recycle bin, own TEMP, own Teams cache only while Teams is closed) and after
         it Script as SYSTEM (component store cleanup with DISM, Delivery Optimization cache, old files in Windows\Temp, old
         Intune content). Never part of "Fix all problems": it can take long and empties the recycle bin.
         Optional UserScript: a script of the user context, started by SelfX itself (never by the service) before Script.
         Name="C:" limits the button to the system drive; change it when Windows is on another drive. -->
    <Remediation Id="Disk" Name="C:" Script="SelfX_Device_FreeSpace.ps1" UserScript="SelfX_Device_FreeSpaceUser.ps1" When="NotOK" TimeoutSeconds="3600" TerminalServer="Hide" />
  </Remediations>
</HealthConfig>
